*.swp
.DS_Store
Thumbs.db
desktop.ini

# ─── mobile builds and SIGNING KEYS ────────────────────────────────────────
# PUBLISHING.md tells you to run `npx cap add android` inside this directory.
# A release signing key committed to a public repo is unrecoverable: anyone can
# then publish a package that Play accepts as an update to this app. Added
# BEFORE the android/ tree exists, so it can never be staged by a `git add .`.
android/
ios/
*.keystore
*.jks
*.aab
*.apk
keystore.properties
local.properties
.gradle/

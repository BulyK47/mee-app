<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- `android:windowBackground` and not the launch theme's: Capacitor's BridgeActivity calls
         setTheme(AppTheme_NoActionBar) before it inflates anything, so this is the theme in force
         for the whole life of the activity, and AppTheme.NoActionBarLaunch governs only the
         starting window.

         It matters because of the OLDER-WebView path. On a WebView below 140 the SystemBars plugin
         pads the web view's parent instead of passing the insets into the page, so the app does not
         paint the strip behind the clock — the decor does, and the plugin repaints it from
         `android:windowBackground` on every setStyle call. Left unset, that resolves through
         Theme.AppCompat.DayNight to the platform's #FAFAFA / #303030, i.e. it follows the PHONE's
         light/dark setting, while the icon colour follows the APP's theme. Two of the four
         combinations are then unreadable: white icons on a white band, or dark icons on a
         near-black one — which is precisely the failure the theme-colour code in App.tsx exists to
         prevent. Pinning it to the app's own background also removes the cold-start flash and the
         band that shows for a frame while the soft keyboard animates. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/splashBackground</item>
    </style>


    <!-- The launch screen is a flat colour, not an image.
         `npx capacitor-assets generate` writes 26 splash PNGs - one per density and orientation,
         day and night - which came to 4.7 MB on disk and 1.8 MB inside the bundle, a third of the
         download, for something on screen for a fraction of a second. Worse, the day variant it
         generates has a WHITE background, so a dark app flashed white on every cold start unless
         the phone happened to be in system dark mode.
         From Android 12 the system draws the launch screen itself, using the launcher icon over
         `windowSplashScreenBackground` - the PNGs were never consulted there anyway. Older devices
         fall back to `android:background`, and get the same flat colour without the icon. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name="android:background">@color/splashBackground</item>
    </style>
</resources>